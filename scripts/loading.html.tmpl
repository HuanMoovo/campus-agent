<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'">
  <title>Mens</title>
  <style>
    :root{color-scheme:light dark}
    body{margin:0;background:#ffffff;color:#202020;font-family:'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;display:grid;place-items:center;height:100vh;text-align:center}
    .mark{display:block;object-fit:contain;width:72px;height:72px;margin:0 auto}
    h1{font-size:24px;font-weight:600;margin:20px 0 10px}p{font-size:13px;color:#666666;line-height:1.6}
    .progress{height:2px;width:128px;margin:24px auto;background:#e8e8e8;overflow:hidden;border-radius:2px}
    .progress:before{content:'';display:block;height:100%;width:50%;background:#525252;animation:move 1.2s ease-in-out infinite}
    @keyframes move{from{transform:translateX(-100%)}to{transform:translateX(220%)}}
    @media(prefers-color-scheme:dark){body{background:#181818;color:#ededed}p{color:#a3a3a3}.progress{background:#333333}.progress:before{background:#bdbdbd}}
    @media(prefers-reduced-motion:reduce){.progress:before{animation:none;width:100%}}
  </style>
</head>
<body><main><img class="mark" src="__MENS_LOGO_DATA_URL__" alt=""><h1>Mens</h1><p>正在准备本地服务…</p><div class="progress"></div><p>首次启动可能需要片刻</p></main></body>
</html>
