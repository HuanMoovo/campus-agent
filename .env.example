# Use a long random URL-safe password (letters, digits, hyphens, underscores).
POSTGRES_PASSWORD=
ADMIN_TOKEN=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
QWEN_MODEL=qwen3-235b-a22b
DEEPSEEK_MODEL=deepseek-chat
ENABLE_RAG=false
PLUGIN_ALLOWED_HOSTS=
# Optional live web search for the chat agent. Set WEB_SEARCH_ENABLED=true to allow it
# (an administrator can also manage this in Settings). Provider: auto (default), bing
# (keyless, reachable from mainland China), tavily or bocha (need WEB_SEARCH_API_KEY).
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_FETCH_PAGES=2
# Optional update check: an HTTPS JSON manifest such as
# {"version": "1.2.0", "url": "https://example.edu/mens-1.2.0.exe", "notes": "修复与改进"}.
# Leave empty to keep the app fully offline.
UPDATE_MANIFEST_URL=
